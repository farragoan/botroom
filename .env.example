# Copy this to .env and fill in your keys. Never commit .env.
GROQ_API_KEY=gsk_...

# Provider feature flags (true/false)
ENABLE_GROQ=true
ENABLE_OPENROUTER=false
# OPENROUTER_API_KEY=sk-or-v1-...

# Auth + storage
VITE_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=...

# Sub-path deploy (leave empty for local dev at /)
NEXT_PUBLIC_BASE_PATH=/botroom

# Billing is permanently off (Razorpay removed)
BILLING_ENABLED=false
